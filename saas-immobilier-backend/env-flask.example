# Variables d'environnement du backend Flask (app.py).
# Sur Render : onglet Environment. En local : copier ce fichier en .env (jamais sur GitHub).
# Le fichier .env.example existant décrit l'ancien backend Node et n'est plus à jour.

# OBLIGATOIRE. Signe les jetons de connexion. L'application refuse de démarrer
# si elle est absente ou fait moins de 32 caractères.
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (JWT_SECRET est aussi accepté, pour compatibilité avec l'ancien .env.example.)
SECRET_KEY=

# OBLIGATOIRE. Adresse de la base PostgreSQL (fournie par Render).
DATABASE_URL=

# Clé de l'API Anthropic pour l'extraction de fiches prospect (route /api/v1/extract).
ANTHROPIC_API_KEY=

# Domaines autorisés à appeler l'API, séparés par des virgules.
# Déjà autorisés sans rien écrire : saas-immobilier*.vercel.app des équipes Vercel
# immo-flow et zelyro, et localhost. À renseigner pour toute autre adresse
# (domaine personnalisé, autre nom de projet Vercel).
# ALLOWED_ORIGINS=https://app.zelyro.fr,https://www.zelyro.fr

# Durée de validité d'une connexion, en heures (défaut : 24).
# TOKEN_LIFETIME_HOURS=24

# Nombre de proxys de confiance devant l'application (défaut : 1, Render).
# Sert à lire la vraie adresse IP du visiteur pour les limites de débit.
# Si les inscriptions sont refusées (429) pour tout le monde, essayer 2.
# TRUSTED_PROXIES=1

# Stockage partagé des compteurs de limites de débit (défaut : mémoire de chaque worker).
# Avec plusieurs workers gunicorn, un Redis rend les limites exactes.
# RATELIMIT_STORAGE_URI=redis://...

# Créer les tables au démarrage (1 = oui). Non nécessaire si la base existe déjà.
# INIT_DB_ON_START=0

# Uniquement pour `python app.py init-db --demo` : mot de passe du compte de démonstration
# (aléatoire et affiché une seule fois s'il n'est pas défini).
# DEMO_PASSWORD=

# --- Mot de passe oublié (envoi d'e-mails via Brevo) ---
# Sans ces trois variables, « changer son mot de passe » fonctionne quand même,
# mais « mot de passe oublié » répond que l'envoi n'est pas activé.
# Clé API Brevo (Brevo : SMTP et API > Clés API). À ne jamais écrire dans GitHub ni dans un message.
# BREVO_API_KEY=
# Adresse d'expédition, à valider dans Brevo (Expéditeurs) avant de l'utiliser.
# MAIL_FROM=contact@votre-domaine.fr
# MAIL_FROM_NAME=Zelyro
# Adresse exacte du site, sans / final : c'est elle qui sert à fabriquer le lien de l'e-mail.
# FRONTEND_URL=https://app.zelyro.fr
# Durée de validité du lien, en minutes (défaut : 30).
# RESET_TOKEN_MINUTES=30
